{
	"env": {
		"browser": true,
		"es2021": true
	},
	"root": true,
	"parser": "@typescript-eslint/parser",
	"plugins": ["@typescript-eslint", "prettier",  "html"],
	"extends": [
        "eslint:recommended",
		"plugin:@typescript-eslint/eslint-recommended",
		"plugin:@typescript-eslint/recommended",
        "prettier"
	],
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module"
	},
    "rules": {
		"prettier/prettier": 2
	}
}
